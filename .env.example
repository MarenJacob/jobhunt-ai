# Core
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DBNAME
SECRET_KEY=replace-with-a-long-random-secret

# AI
OPENAI_API_KEY=your-openai-key
OPENAI_MODEL=gpt-4.1-mini
TAVILY_API_KEY=your-tavily-key
SEARCH_PROVIDER=tavily

# Autonomous policy
AUTO_SUBMIT=false
MAX_APPLICATIONS_PER_DAY=30
MINIMUM_MATCH_SCORE=70
MAX_REQUIRED_YEARS=2
BLOCKED_ROLE_TERMS=senior,staff,principal,director,vp,head of
ALLOWED_DOMAINS=greenhouse.io,lever.co,ashbyhq.com,smartrecruiters.com,wellfound.com,weworkremotely.com,linkedin.com,indeed.com

# Browser session / resume. Never commit these.
BROWSER_PROFILE_DIR=storage/browser-profile
BROWSER_HEADLESS=true
RESUME_PATH=

# Optional direct email applications: omit these if unused.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Optional Vercel cron protection. Omit if unused.
CRON_SECRET=

# Real ATS browser worker (recommended for production)
BROWSER_WORKER_URL=http://browser-worker:8090
BROWSER_WORKER_SECRET=replace-with-a-long-browser-worker-secret
BROWSER_WORKER_TIMEOUT=120
BROWSER_SESSION_NAME=default
